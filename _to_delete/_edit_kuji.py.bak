for old, new in replacements:
    count = html.count(old)
    if count != 1:
        print("MISMATCH (count=%d): %s" % (count, old[:60].replace('\n','\\n')))
        sys.exit(1)
    html = html.replace(old, new)

with io.open(path, "w", encoding="utf-8") as f:
    f.write(html)

print("index.html: all replacements applied OK")

path2 = "pages/ichiban-kuji/style.css"
with io.open(path2, encoding="utf-8") as f:
    css = f.read()

css_replacements = []
css_replacements.append((
'''/* S賞のバー（ダークゴールド → 明るいゴールド） */
.kuji-card--s .kuji-card__bar {
  background: linear-gradient(90deg, var(--kuji-gold-dark), var(--kuji-s-prize), #D4A853);
}''',
'''/* A賞のバー（ダークゴールド → 明るいゴールド） */
.kuji-card--a .kuji-card__bar {
  background: linear-gradient(90deg, var(--kuji-gold-dark), var(--kuji-top-prize), #D4A853);
}'''
))
css_replacements.append((
'''/* S賞ラベル（ゴールド強調） */
.kuji-card--s .kuji-card__prize {
  color: var(--kuji-s-prize);
  background: rgba(184, 134, 11, 0.08);
  border-color: rgba(184, 134, 11, 0.25);
}''',
'''/* A賞ラベル（ゴールド強調） */
.kuji-card--a .kuji-card__prize {
  color: var(--kuji-top-prize);
  background: rgba(184, 134, 11, 0.08);
  border-color: rgba(184, 134, 11, 0.25);
}'''
))
css_replacements.append((
'''  --kuji-s-prize:     #B8860B;   /* S賞（ダークゴールド） */''',
'''  --kuji-top-prize:   #B8860B;   /* 一番人気の賞（ダークゴールド） */'''
))

for old, new in css_replacements:
    count = css.count(old)
    if count != 1:
        print("CSS MISMATCH (count=%d): %s" % (count, old[:60].replace('\n','\\n')))
        sys.exit(1)
    css = css.replace(old, new)

with io.open(path2, "w", encoding="utf-8") as f:
    f.write(css)

print("style.css: all replacements applied OK")
